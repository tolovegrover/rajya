{
  "expo": {
    "name": "Rajya: Rise of Kings",
    "slug": "rajya-rise-of-kings",
    "version": "0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f1a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nations.rajya"
    },
    "android": {
      "package": "com.nations.rajya",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0"
    },
    "plugins": [
      "expo-asset"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}